# =============================================================================
# Transit Atlas - Jedinstvena .env konfiguracija
# =============================================================================
# Kopirajte ovaj fajl u .env i promijenite vrijednosti prema vašem okruženju

# -----------------------------------------------------------------------------
# MongoDB Database
# -----------------------------------------------------------------------------
MONGODB_URI=
# Za produkciju koristite MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/transit-atlas?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Security Secrets - GENERIRAJTE NOVE RANDOM VRIJEDNOSTI ZA PRODUKCIJU
# -----------------------------------------------------------------------------
# Generirajte s: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
PASSWORD_PEPPER=replace-with-a-different-unique-random-secret-at-least-32-characters
ADMIN_PANEL_PASSWORD=replace-with-a-unique-admin-password-16-chars-min

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (Anti-bot zaštita)
# -----------------------------------------------------------------------------
# Registrirajte se na: https://dash.cloudflare.com/
# Za testiranje možete koristiti dummy ključeve (automatski se preskače u dev modu)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ORIGIN=http://localhost:3000
# Za produkciju dodajte svoje domene:
# APP_ORIGIN=https://vaša-domena.com,https://www.vaša-domena.com

PORT=3001
NODE_ENV=development
# Za produkciju: NODE_ENV=production

# -----------------------------------------------------------------------------
# Trust Proxy (samo za produkciju)
# -----------------------------------------------------------------------------
# Postavite broj proxy layera između korisnika i aplikacije
# Npr. ako je hosting iza 1 proxy layera (Heroku, Render, Vercel):
# TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Frontend (Vite) - isti .env fajl
# -----------------------------------------------------------------------------
# Leave empty in production to use same-origin API routes.
VITE_API_URL=
# Za produkciju:
# VITE_API_URL=https://vaša-domena.com

VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Za produkciju koristite isti SITE KEY kao gore

# -----------------------------------------------------------------------------
# Email (obavezno za produkcijsku registraciju i oporavak računa)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Transit Atlas <noreply@example.com>
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GTFS Feeds (OPCIONALNO - za custom izvore)
# -----------------------------------------------------------------------------
# HZPP_GTFS_URL=https://www.hzpp.hr/GTFS_files.zip
